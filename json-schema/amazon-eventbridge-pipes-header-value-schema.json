  "$id": "https://raw.githubusercontent.com/api-evangelist/amazon-eventbridge-pipes/refs/heads/main/json-schema/amazon-eventbridge-pipes-header-value-schema.json",
  "title": "HeaderValue",
  "description": "HeaderValue schema from Amazon EventBridge Pipes",
  "type": "string",
  "format": "password",
  "pattern": "^[ \\t]*[\\x20-\\x7E]+([ \\t]+[\\x20-\\x7E]+)*[ \\t]*|(\\$(\\.[\\w/_-]+(\\[(\\d+|\\*)\\])*)*)$",
  "minLength": 0,
  "maxLength": 512
}